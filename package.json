{
  "name": "@dodefey/db-helper",
  "version": "0.2.2",
  "description": "Operational MongoDB backup, sync, restore, and recovery CLI",
  "author": "David Odefey",
  "homepage": "https://github.com/dodefey/db-helper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodefey/db-helper.git"
  },
  "bugs": {
    "url": "https://github.com/dodefey/db-helper/issues"
  },
  "license": "MIT",
  "keywords": [
    "mongodb",
    "backup",
    "restore",
    "sync",
    "cli"
  ],
  "type": "module",
  "bin": {
    "dbh": "bin/dbh.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "prepack": "npm run build",
    "test": "tsx --test tests/**/*.test.ts",
    "test:restore-integration": "tsx scripts/restore-integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run format:check && npm run lint && npm test && npm run typecheck && npm run build",
    "start": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
