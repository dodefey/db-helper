{
  "defaults": {
    "authSource": "admin",
    "defaultDropOnRestore": true
  },
  "paths": {
    "backupRoot": "~/db-helper-backups",
    "tempRoot": "/tmp/db-helper"
  },
  "environments": {
    "local": {
      "label": "Local Development",
      "kind": "local",
      "host": "localhost",
      "mongoHost": "localhost",
      "mongoPort": 27017,
      "databaseName": "development",
      "mongoUser": "REPLACE_WITH_LOCAL_MONGO_USER",
      "mongoPassword": "REPLACE_WITH_LOCAL_MONGO_PASSWORD",
      "isProduction": false
    },
    "staging": {
      "label": "Test Server",
      "kind": "remote",
      "host": "test.example.com",
      "mongoHost": "localhost",
      "mongoPort": 27017,
      "databaseName": "development",
      "sshUser": "",
      "sshKeyPath": "",
      "mongoUser": "REPLACE_WITH_STAGING_MONGO_USER",
      "mongoPassword": "REPLACE_WITH_STAGING_MONGO_PASSWORD",
      "isProduction": false
    },
    "live": {
      "label": "Production Server",
      "kind": "remote",
      "host": "prod.example.com",
      "mongoHost": "localhost",
      "mongoPort": 27017,
      "databaseName": "production",
      "sshUser": "",
      "sshKeyPath": "",
      "mongoUser": "REPLACE_WITH_PRODUCTION_MONGO_USER",
      "mongoPassword": "REPLACE_WITH_PRODUCTION_MONGO_PASSWORD",
      "isProduction": true
    }
  }
}
